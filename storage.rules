rules_version = '2';

/**
 * Firebase Storage rules.
 *
 * Uploads go straight from the browser to Storage rather than through the
 * Next.js server — Server Actions have a small request body limit, and photos
 * are large. That makes these rules the actual gate on who can write, not a
 * formality.
 *
 * Deploy with:  firebase deploy --only storage
 *
 * NOTE: keep this allowlist in sync with ADMIN_EMAILS in .env.local and with
 * firestore.rules.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'rohanvenkatesha@gmail.com'
           ];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // 20MB — comfortably above a web-sized export, well below a full RAW.
    function withinSizeLimit() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // Site media: publicly readable, admin-writable, images only.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && withinSizeLimit();
      allow delete: if isAdmin();
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

/**
 * Firestore security rules — the second line of defence.
 *
 * The app already gates /admin server-side, but these rules matter because
 * anyone can call the Firestore REST/SDK API directly with a signed-in token,
 * bypassing the app entirely. Without them, any Google account could write.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 *
 * NOTE: keep this allowlist in sync with ADMIN_EMAILS in .env.local.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'rohanvenkatesha@gmail.com'
           ];
    }

    // Published site content: world-readable, admin-writable.
    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings, including section visibility.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not matched above is denied outright.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
